<Window x:Class="CindrixVPN.Client.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="True" FontFamily="Segoe UI">
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource AccentDeep}" BorderThickness="1"
            CornerRadius="12" Padding="18" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="CINDRIX VPN" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="StatsText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />

            <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Content="Connect"
                    Margin="0,14,0,0" Click="ToggleButton_Click" />

            <TextBlock Text="SERVER" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,16,0,4" />
            <ComboBox x:Name="ServerBox" Height="30" SelectionChanged="ServerBox_SelectionChanged" />

            <CheckBox x:Name="StartupCheck" Content="Start with Windows" Foreground="{StaticResource Text}"
                      Margin="0,14,0,0" Click="StartupCheck_Click" />
            <CheckBox x:Name="AutoConnectCheck" Content="Connect when app starts" Foreground="{StaticResource Text}"
                      Margin="0,8,0,0" Click="AutoConnectCheck_Click" />

            <Button Style="{StaticResource GhostButton}" Content="Open dashboard" Margin="0,16,0,0"
                    Click="OpenDashboard_Click" />
        </StackPanel>
    </Border>
</Window>
