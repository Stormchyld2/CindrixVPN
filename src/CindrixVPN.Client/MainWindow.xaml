<Window x:Class="CindrixVPN.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CindrixVPN" Icon="Assets/cindrixvpn.ico" Width="440" Height="720" MinWidth="400" MinHeight="680"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="CINDRIX VPN" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
            <TextBlock Text="PRIVATE  •  FAST  •  YOURS" FontFamily="Consolas" FontSize="10"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="96" Height="96" Fill="{StaticResource PanelLight}"
                     Stroke="{StaticResource Muted}" StrokeThickness="3" />
            <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,18,0,2" />
            <TextBlock x:Name="DetailText" Text="Your traffic is not protected" FontSize="13"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock x:Name="StatsText" Text="" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="SERVER" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
            <ComboBox x:Name="ServerBox" Height="34" FontSize="14" SelectionChanged="ServerBox_SelectionChanged" />
            <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="Connect"
                    Margin="0,16,0,0" Click="ConnectButton_Click" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource Danger}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <CheckBox x:Name="StartupCheck" Content="Start CindrixVPN with Windows" Foreground="{StaticResource Text}"
                      Click="StartupCheck_Click" />
            <CheckBox x:Name="AutoConnectCheck" Content="Connect automatically when the app starts"
                      Foreground="{StaticResource Text}" Margin="0,8,0,0" Click="AutoConnectCheck_Click" />
        </StackPanel>

        <Border Grid.Row="5" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="THIS DEVICE'S PUBLIC KEY" FontSize="11" Foreground="{StaticResource Muted}" />
                <TextBox x:Name="PublicKeyBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         Margin="0,6,0,8" TextWrapping="Wrap" />
                <Button Style="{StaticResource GhostButton}" Content="Copy key" HorizontalAlignment="Left"
                        Click="CopyKey_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
