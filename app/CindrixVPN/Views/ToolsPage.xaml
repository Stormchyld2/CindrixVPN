<UserControl x:Class="CindrixVPN.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,18,22,18">
        <Border Style="{StaticResource Panel}" Padding="22">
            <StackPanel>
                <TextBlock Text="Tools" Style="{StaticResource Heading}" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="Check my public IP" Style="{StaticResource GhostButton}" Click="Ip_Click" Margin="0,0,10,0"/>
                    <Button Content="Test DNS" Style="{StaticResource GhostButton}" Click="Dns_Click" Margin="0,0,10,0"/>
                    <Button Content="Flush DNS cache" Style="{StaticResource GhostButton}" Click="Flush_Click"/>
                </StackPanel>
                <TextBox x:Name="Output" IsReadOnly="True" Height="220" TextWrapping="Wrap" FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
