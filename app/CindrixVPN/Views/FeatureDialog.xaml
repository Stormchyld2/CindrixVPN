<Window x:Class="CindrixVPN.Views.FeatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Panel}" Margin="14" Padding="22">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock x:Name="IconText" Style="{StaticResource Glyph}" FontSize="30" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Heading}" FontSize="22"/>
                    <TextBlock x:Name="ProfileText" Style="{StaticResource Muted}" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,4,0,14" FontSize="14"/>

            <StackPanel x:Name="SwitchRow" Orientation="Horizontal" Margin="0,0,0,14">
                <ToggleButton x:Name="FeatureSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SwitchLabel" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15"/>
            </StackPanel>

            <StackPanel x:Name="SplitBox" Margin="0,0,0,14">
                <TextBlock Text="Addresses that bypass the VPN (one per line)" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <TextBox x:Name="ExcludesBox" AcceptsReturn="True" Height="130" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </StackPanel>

            <TextBlock x:Name="NoteText" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,16"/>

            <Button Content="Done" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Width="110" Click="Done_Click"/>
        </StackPanel>
    </Border>
</Window>
