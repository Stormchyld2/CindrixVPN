<UserControl x:Class="CindrixVPN.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,18,22,18">
        <Border Style="{StaticResource Panel}" Padding="22">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Image Source="/Assets/logo-about.png" Height="150" Margin="0,0,0,14"/>
                <TextBlock Text="Cindrix VPN" Style="{StaticResource Heading}" HorizontalAlignment="Center" FontSize="26"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,16"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,0,0,12"
                           Text="A private family VPN. It connects through WireGuard to your own server, so your traffic never goes through a third-party VPN company."/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Muted}" FontSize="12.5"
                           Text="Uses the official WireGuard for Windows. “WireGuard” is a registered trademark of Jason A. Donenfeld. Parts of this repository derive from Proton VPN's GPL-3.0 open source code."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
