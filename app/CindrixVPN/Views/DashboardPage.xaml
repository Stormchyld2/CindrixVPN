<UserControl x:Class="CindrixVPN.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CindrixVPN.Common">

    <UserControl.Resources>
        <c:TickGlyphConverter x:Key="TickGlyph"/>
        <c:TickBrushConverter x:Key="TickBrush"/>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Feature tiles -->
        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,14">
            <Button Style="{StaticResource TileButton}" Tag="NetShield" Click="Tile_Click" Margin="0,0,7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="30" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NetShield" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Ad/Tracker/Threat Blocking" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding NetShieldState}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource TileButton}" Tag="KillSwitch" Click="Tile_Click" Margin="7,0,7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="30" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Kill Switch" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Block Internet if VPN Drops" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding KillSwitchState}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource TileButton}" Tag="SplitTunneling" Click="Tile_Click" Margin="7,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE72D;" Style="{StaticResource Glyph}" FontSize="30" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Split Tunneling" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose What Uses VPN" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding SplitState}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Button>
        </UniformGrid>

        <!-- Centre panel + right column -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.75*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Connection panel -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid Margin="24,10,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" Source="Assets/logo-center.png" Stretch="Uniform" MaxHeight="250"
                           Margin="0,4,0,4" HorizontalAlignment="Center"/>

                    <Grid Grid.Row="1" Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{StaticResource LineBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="1" Text="C O N N E C T I O N   S T A T U S" FontSize="13"
                                   Style="{StaticResource Muted}"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource LineBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="22" Height="22" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,4,14,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#34E27A" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                       FontSize="44" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusSubtitle}" FontSize="16" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Server card -->
                    <Border Grid.Row="3" Style="{StaticResource Panel}" Background="#08121F" Margin="30,14,30,10" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ServerNameText}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ProfileName}" Style="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center" Background="#0C2A1A" BorderBrush="#1F8A4C">
                                <TextBlock Text="{Binding ServerBadge}" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Encryption | Protocol | Latency -->
                    <UniformGrid Grid.Row="4" Columns="3" Margin="30,2,30,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding EncryptionText}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Encryption" Style="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding ProtocolText}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Protocol" Style="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE916;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding LatencyText}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Latency" Style="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>

                    <!-- One button that switches between Connect and Disconnect -->
                    <Button Grid.Row="5" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleCommand}"
                            Content="{Binding ConnectButtonText}" Height="56" Width="460" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Session -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="18,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/>
                            <TextBlock Text="Session" Style="{StaticResource Heading}"/>
                        </StackPanel>
                        <Grid Margin="0,3">
                            <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                            <TextBlock Text="Duration" Style="{StaticResource StatLabel}" Margin="26,0,0,0"/>
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left"/>
                            <TextBlock Text="Data Download" Style="{StaticResource StatLabel}" Margin="26,0,0,0"/>
                            <TextBlock Text="{Binding DownTotalText}" Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left"/>
                            <TextBlock Text="Data Upload" Style="{StaticResource StatLabel}" Margin="26,0,0,0"/>
                            <TextBlock Text="{Binding UpTotalText}" Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left"/>
                            <TextBlock Text="Protocol" Style="{StaticResource StatLabel}" Margin="26,0,0,0"/>
                            <TextBlock Text="{Binding ProtocolText}" Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left"/>
                            <TextBlock Text="Server" Style="{StaticResource StatLabel}" Margin="26,0,0,0"/>
                            <TextBlock Text="{Binding ServerNameText}" Style="{StaticResource StatValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Network activity -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xEC05;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/>
                            <TextBlock Text="Network Activity" Style="{StaticResource Heading}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#08121F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="300" Height="70">
                                        <Polygon Points="{Binding SpeedArea}" Fill="{StaticResource SparkFill}"/>
                                        <Polyline Points="{Binding SpeedLineUp}" Stroke="{StaticResource GreenBrush}" StrokeThickness="1.1" Opacity="0.85"/>
                                        <Polyline Points="{Binding SpeedLine}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Style="{StaticResource Pill}" Margin="0,0,0,8" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DownSpeedText}" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Pill}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding UpSpeedText}" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Protection status -->
                <Border Grid.Row="4" Style="{StaticResource Panel}" Padding="18,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/>
                            <TextBlock Text="Protection Status" Style="{StaticResource Heading}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,10,0"
                                       Text="{Binding TunnelOk, Converter={StaticResource TickGlyph}}"
                                       Foreground="{Binding TunnelOk, Converter={StaticResource TickBrush}}"/>
                            <TextBlock Text="{Binding TunnelText}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,10,0"
                                       Text="{Binding KillOk, Converter={StaticResource TickGlyph}}"
                                       Foreground="{Binding KillOk, Converter={StaticResource TickBrush}}"/>
                            <TextBlock Text="{Binding KillText}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,10,0"
                                       Text="{Binding NetShieldOk, Converter={StaticResource TickGlyph}}"
                                       Foreground="{Binding NetShieldOk, Converter={StaticResource TickBrush}}"/>
                            <TextBlock Text="{Binding NetShieldText}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,10,0"
                                       Text="{Binding DnsOk, Converter={StaticResource TickGlyph}}"
                                       Foreground="{Binding DnsOk, Converter={StaticResource TickBrush}}"/>
                            <TextBlock Text="{Binding DnsText}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,10,0"
                                       Text="{Binding Ipv6Ok, Converter={StaticResource TickGlyph}}"
                                       Foreground="{Binding Ipv6Ok, Converter={StaticResource TickBrush}}"/>
                            <TextBlock Text="{Binding Ipv6Text}" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="20,10">
            <UniformGrid Columns="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="VPN IP Address" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding ExitIpText}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Server" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding ServerNameText}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Protection" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding ProtectionText}" Foreground="{Binding ProtectionBrush}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="26" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Server Load" Style="{StaticResource Muted}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ServerLoadText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ServerLoad, Mode=OneWay}" Width="90" Height="8"
                                         Foreground="{StaticResource GreenBrush}" Background="#16324D" BorderThickness="0"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
