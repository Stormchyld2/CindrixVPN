<UserControl x:Class="CindrixVPN.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,18,22,18">
        <Border Style="{StaticResource Panel}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Logs" Style="{StaticResource Heading}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copy all" Style="{StaticResource GhostButton}" Click="Copy_Click" Margin="0,0,8,0"/>
                        <Button Content="Open log folder" Style="{StaticResource GhostButton}" Click="Folder_Click"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
