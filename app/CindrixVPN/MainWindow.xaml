<Window x:Class="CindrixVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cindrix VPN" Width="1280" Height="780" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Icon="Assets/app.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" Description="Cindrix VPN"/>
    </Window.TaskbarItemInfo>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Background="{StaticResource TopBarBrush}">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Image Source="Assets/logo-small.png" Height="36" Margin="0,0,12,0"/>
                <TextBlock Text="Cindrix" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text=" VPN" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close to tray"/>
            </StackPanel>
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}"/>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" Source="Assets/logo-sidebar.png" Margin="26,18,26,14" Stretch="Uniform" MaxHeight="190"/>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard"
                                     GroupName="nav" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavProfiles" Style="{StaticResource NavButton}" Tag="&#xE716;" Content="Profiles"
                                     GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="&#xE8A5;" Content="Logs"
                                     GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Tools"
                                     GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                     GroupName="nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="&#xE946;" Content="About"
                                     GroupName="nav" Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- Mountain art along the bottom of the sidebar -->
                    <Viewbox Grid.Row="2" VerticalAlignment="Bottom" Stretch="Fill" Height="150">
                        <Canvas Width="220" Height="150">
                            <Path Data="M0,150 L0,95 L28,60 L46,78 L84,18 L118,70 L142,48 L178,92 L200,70 L220,100 L220,150 Z"
                                  StrokeThickness="1.5" Stroke="#2B9BE8">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#661DB4FF" Offset="0"/>
                                        <GradientStop Color="#0A0D2036" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M84,18 L70,46 L84,40 L96,52 L106,44 L118,70" Stroke="#9AD7FF" StrokeThickness="1"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Page area -->
            <ContentControl x:Name="PageHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
